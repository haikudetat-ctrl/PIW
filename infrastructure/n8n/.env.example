# Pin and deliberately upgrade this value in a reviewed PR.
N8N_VERSION=2.6.4
N8N_HOST=automation.example.com
N8N_PROTOCOL=https
N8N_PORT=5678
WEBHOOK_URL=https://automation.example.com/
GENERIC_TIMEZONE=America/New_York

POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=generate-a-unique-password
N8N_ENCRYPTION_KEY=generate-a-unique-64-character-secret

# Allows Code nodes to use Node's cryptography module only.
NODE_FUNCTION_ALLOW_BUILTIN=crypto

# Optional Slack incoming webhook consumed by the checked-in error workflow.
SLACK_ALERT_WEBHOOK_URL=

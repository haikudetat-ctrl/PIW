# Must exactly match PIW's value for signed Advertising-consent handoffs
# (32+ bytes; never commit its value).
PRIVACY_CONSENT_SIGNING_SECRET=
NEXT_PUBLIC_META_TRACKING_ENABLED=false
NEXT_PUBLIC_META_PIXEL_ID=3142520615938086
INTAKE_WEBHOOK_URL=https://piw-preview.example.com/api/integrations/all-season/intake
INTAKE_ADDRESS_SUGGESTIONS_URL=https://piw-preview.example.com/api/integrations/all-season/address-suggestions
# Canonical assessment adapter. Use the matching PIW environment and an HTTPS URL in production.
CAMPAIGN_ESTIMATE_WEBHOOK_URL=https://piw-preview.example.com/api/integrations/all-season/campaign-estimate
# Must exactly match PIW's ALL_SEASON_INTAKE_SHARED_SECRET.
INTAKE_WEBHOOK_SHARED_SECRET=
# Origin only: no path, query, credentials, or trailing route. HTTP is accepted only locally.
PIW_PUBLIC_APP_URL=https://piw-preview.example.com
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_PLACE_ID=ChIJ45RSnZvmwIkRTKQQ-sW_09k
# Keep false pending All Season's legal and provider sign-off.
NEXT_PUBLIC_ANALYTICS_DEFAULT_ON=false

# Value-first quote flow (address step -> roof reveal -> contact on the estimate host).
# Keep false until the rollout runbook says otherwise; false renders the legacy forms.
NEXT_PUBLIC_PROPERTY_PREVIEW_ENABLED=false
# The quote drawer opens as a chat (needs the preview flow and PIW's
# QUOTE_CHAT_ENABLED). See docs/runbooks/quote-chat.md.
NEXT_PUBLIC_QUOTE_CHAT_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
PROPERTY_PREVIEW_WEBHOOK_URL=https://piw-preview.example.com/api/integrations/all-season/property-preview

# Google Search Ads (docs/runbooks/google-ads.md).
# Signs the first-party as_attr attribution cookie; must match PIW's value (32+ bytes).
AD_ATTRIBUTION_SIGNING_SECRET=
# Sends click IDs, ValueTrack values and search landing slugs to PIW. Turn on
# only after the PIW deploy with migration 20261025120000 is live.
AD_ATTRIBUTION_FORWARDING_ENABLED=false
# Browser Google tag (conversion linker, page views, optional call number
# swap). Lead conversions are uploaded by PIW, never from the browser.
NEXT_PUBLIC_GOOGLE_ADS_TRACKING_ENABLED=false
NEXT_PUBLIC_GOOGLE_ADS_TAG_ID=
# opt_in (default): ad tags wait for an Advertising grant. opt_out: only if AllSeason decides NJDPA allows it.
NEXT_PUBLIC_ADVERTISING_CONSENT_MODEL=opt_in
# Website call conversions: label from the Google Ads call conversion action and
# the number exactly as it appears on the page, "(866) 835-6022".
NEXT_PUBLIC_GOOGLE_ADS_CALL_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_CALL_TRACKED_NUMBER=
# NJ Home Improvement Contractor registration number, shown on the search pages once set.
NEXT_PUBLIC_NJ_HIC_REGISTRATION=

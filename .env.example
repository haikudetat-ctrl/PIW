NODE_ENV=development
DEPLOYMENT_ENV=development
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1
PAID_PROVIDERS_ENABLED=false
# LeadConduit receipt is off until each approved receiver is enabled.
INTEGRATIONS_LEADCONDUIT_ROOFING_RECEIVER_ENABLED=false
INTEGRATIONS_LEADCONDUIT_VIRTUAL_QUOTE_RECEIVER_ENABLED=false
INTEGRATIONS_LEADMASTER_ENABLED=false
INTEGRATIONS_JOBNIMBUS_ENABLED=false
INTEGRATIONS_JOBNIMBUS_CANARY_ENABLED=false
INTEGRATIONS_CALLTOOLS_ENABLED=false
# Configure only the approved Roofing and Roofing Virtual Quote flow IDs.
LEADCONDUIT_ROOFING_FLOW_ID=
LEADCONDUIT_VIRTUAL_QUOTE_FLOW_ID=
# Webhook tokens are server-only. A next token needs an ISO 8601 UTC expiry.
LEADCONDUIT_ROOFING_WEBHOOK_TOKEN=
LEADCONDUIT_ROOFING_WEBHOOK_TOKEN_NEXT=
LEADCONDUIT_ROOFING_WEBHOOK_TOKEN_NEXT_EXPIRES_AT=
LEADCONDUIT_VIRTUAL_QUOTE_WEBHOOK_TOKEN=
LEADCONDUIT_VIRTUAL_QUOTE_WEBHOOK_TOKEN_NEXT=
LEADCONDUIT_VIRTUAL_QUOTE_WEBHOOK_TOKEN_NEXT_EXPIRES_AT=
LEADMASTER_ACCESS_TOKEN=
LEADMASTER_BASE_URL=https://devwebapi.leadmaster.com
# Comma-separated labels used to constrain reporting after account discovery.
LEADMASTER_WORKGROUPS=roofing,roofing virtual quote
LEADMASTER_LOOKBACK_MINUTES=1440
JOBNIMBUS_API_KEY=
JOBNIMBUS_BASE_URL=https://app.jobnimbus.com
# Confirm these read endpoints against the granted account before enabling.
JOBNIMBUS_CONTACTS_PATH=/api1/contacts
JOBNIMBUS_JOBS_PATH=/api1/jobs
JOBNIMBUS_PAGE_LIMIT=50
JOBNIMBUS_MAX_PAGES=1
JOBNIMBUS_INCLUDE_SOLD_VALUE=false
ACCESS_ROUTE_COMPANY_ID=
CALLTOOLS_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_API_KEY=
ESTIMATE_SMS_WEBHOOK_URL=
ESTIMATE_EMAIL_WEBHOOK_URL=
ESTIMATE_DELIVERY_SHARED_SECRET=
SLACK_CONTEXT_DIALER_WEBHOOK_URL=
CONTEXT_DIALER_BASE_URL=
ROOF_ESTIMATE_COMPANY_ID=
COST_INTELLIGENCE_ENABLED=false
COST_MONTHLY_BUDGET_USD=1500
SLACK_COST_DIGEST_WEBHOOK_URL=
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
DIGITALOCEAN_TOKEN=
GOOGLE_CLOUD_SERVICE_ACCOUNT_JSON=
GOOGLE_CLOUD_BILLING_PROJECT_ID=
GOOGLE_CLOUD_BILLING_TABLE=
SUPABASE_COST_CONFIG_JSON=
COST_RESOURCE_MAP_JSON=

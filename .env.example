NODE_ENV=development
DEPLOYMENT_ENV=development
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1
PAID_PROVIDERS_ENABLED=false
# Master gate for the canonical assessment UI and authenticated All Season adapter.
# Keep false until migrations, both applications, and preview smoke tests are complete.
ROOF_ASSESSMENT_ENABLED=false
# Required for signed assessment continuation URLs and same-browser resume cookies (32+ bytes).
ROOF_ASSESSMENT_SIGNING_SECRET=
# Cross-device resume. Enable only with all three Twilio values below; responses
# deliberately take at least 8.25 seconds and production requires trusted Vercel IP headers.
TWILIO_VERIFY_ENABLED=false
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SERVICE_SID=
INTEGRATIONS_LEADCONDUIT_ENABLED=false
LEADCONDUIT_FILTER_CAVEAT_ACTIVE=true
INTEGRATIONS_LEADMASTER_ENABLED=false
INTEGRATIONS_JOBNIMBUS_ENABLED=false
INTEGRATIONS_CALLTOOLS_ENABLED=false
INTEGRATIONS_WEBHOOK_SHARED_SECRET=
# Server-to-server All Season intake. The secret must exactly match the website's
# INTAKE_WEBHOOK_SHARED_SECRET; the company ID must be the intended tenant UUID.
ALL_SEASON_INTAKE_SHARED_SECRET=
ALL_SEASON_INTAKE_COMPANY_ID=
LEADCONDUIT_API_KEY=
LEADCONDUIT_BASE_URL=https://app.leadconduit.com
LEADMASTER_ACCESS_TOKEN=
LEADMASTER_BASE_URL=https://devwebapi.leadmaster.com
# Comma-separated labels used to constrain reporting after account discovery.
LEADMASTER_WORKGROUPS=roofing,roofing virtual quote
LEADMASTER_LOOKBACK_MINUTES=1440
JOBNIMBUS_API_KEY=
JOBNIMBUS_BASE_URL=https://api.jobnimbus.com
# Confirm these read endpoints against the granted account before enabling.
JOBNIMBUS_CONTACTS_PATH=/api1/contacts
JOBNIMBUS_JOBS_PATH=/api1/jobs
JOBNIMBUS_INCLUDE_SOLD_VALUE=false
ACCESS_ROUTE_COMPANY_ID=
CALLTOOLS_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_API_KEY=
ESTIMATE_SMS_WEBHOOK_URL=
ESTIMATE_EMAIL_WEBHOOK_URL=
ESTIMATE_DELIVERY_SHARED_SECRET=
SLACK_CONTEXT_DIALER_WEBHOOK_URL=
CONTEXT_DIALER_BASE_URL=
ROOF_ESTIMATE_COMPANY_ID=
COST_INTELLIGENCE_ENABLED=false
COST_MONTHLY_BUDGET_USD=1500
SLACK_COST_DIGEST_WEBHOOK_URL=
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
DIGITALOCEAN_TOKEN=
GOOGLE_CLOUD_SERVICE_ACCOUNT_JSON=
GOOGLE_CLOUD_BILLING_PROJECT_ID=
GOOGLE_CLOUD_BILLING_TABLE=
SUPABASE_COST_CONFIG_JSON=
COST_RESOURCE_MAP_JSON=
